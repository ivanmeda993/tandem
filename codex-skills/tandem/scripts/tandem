#!/usr/bin/env bash
# Tandem launcher. Keeps the caller's PATH first and falls back to common
# install locations, since the Codex desktop app can start commands with a
# minimal PATH. Resolves links, so it also works when linked into a bin folder.
export PATH="$PATH:$HOME/.local/bin:/opt/homebrew/bin:/usr/local/bin"
SELF="$(perl -MCwd=abs_path -e 'print abs_path(shift)' "$0")"
exec python3 "$(dirname "$SELF")/tandem_core.py" "$@"
